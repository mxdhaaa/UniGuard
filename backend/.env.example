# UniGuard Backend Environment Configuration Example
# Copy this file to .env and configure for your local/production environment.
# NEVER commit actual secrets, database passwords, or private keys to git.

ENVIRONMENT=development
API_HOST=127.0.0.1
API_PORT=8000
LOG_LEVEL=INFO
ENABLE_DOCS=true

CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# Database Configuration
DATABASE_URL=postgresql+psycopg://uniguard_user:uniguard_secure_password@localhost:5432/uniguard

# Live Ingestion Sensor Settings
CAPTURE_INTERFACE=
CAPTURE_FILTER=ip and (tcp or udp or icmp)
FLOW_IDLE_TIMEOUT=30.0
FLOW_MAX_DURATION=120.0

# PCAP Settings
PCAP_UPLOAD_DIR=./pcap_uploads
PCAP_MAX_FILE_SIZE_MB=50
