# UniGuard Environment Configuration Template
# Copy this file to .env and configure for your local/production environment.
# NEVER commit actual secrets, database passwords, or private keys to git.

# Runtime Environment (development | production | staging)
ENVIRONMENT=development

# API Service Bind Settings
API_HOST=127.0.0.1
API_PORT=8000

# Logging Level (DEBUG | INFO | WARNING | ERROR)
LOG_LEVEL=INFO

# OpenAPI / Swagger Documentation (true | false)
ENABLE_DOCS=true

# CORS Allowed Origins (comma-separated list; wildcard '*' is stripped in production)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# Database Configuration
# Production target: PostgreSQL (postgresql+psycopg://user:password@host:5432/dbname)
# Local development / test fallback: SQLite if left empty (sqlite:///./uniguard.db)
DATABASE_URL=postgresql+psycopg://uniguard_user:uniguard_secure_password@localhost:5432/uniguard

# Live Ingestion Sensor Settings (Scapy)
# Leave CAPTURE_INTERFACE empty to auto-detect or listen on default interface
CAPTURE_INTERFACE=
CAPTURE_FILTER=ip and (tcp or udp or icmp)
FLOW_IDLE_TIMEOUT=30.0
FLOW_MAX_DURATION=120.0

# PCAP Offline Processing Settings
PCAP_UPLOAD_DIR=./pcap_uploads
PCAP_MAX_FILE_SIZE_MB=50

# Frontend Configuration (Used during Vite build/dev)
VITE_API_BASE_URL=http://127.0.0.1:8000
